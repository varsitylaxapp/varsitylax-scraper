DB_HOST=mysql.varsitylaxapp.com
DB_USER=varsitylax
DB_PASSWORD=your_password
DB_NAME=varsitylax
DB_PORT=3306
PORT=3000
SEASON=2026

# ─── Phase 3 migration (runbook Section E) ───────────────────────────────────
# Scraper write target: legacy (default) | dual (E2) | v2 (E6)
WRITE_MODE=legacy
# E4: set true to add Warning:299 deprecation header to all v1 responses
V1_DEPRECATION_WARNING=false
# E5.5: set to add Sunset header, e.g. "Thu, 08 Oct 2026 00:00:00 GMT"
# V1_SUNSET_DATE=
# Playoff window start for /api/v2/schedule/playoffs (default: <season>-05-14)
# PLAYOFFS_START=2026-05-14
